<UserControl x:Class="AdbDesktop.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdbDesktop">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!--
          Tab buttons rather than a TabControl: the stock one brings its own light
          chrome, and templating it away costs more markup than drawing the strip.
        -->
        <Style x:Key="SettingsTabStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="12,8"
                                Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextBlock.Foreground="{StaticResource MutedTextBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource SurfaceHighBrush}"/>
                                <Setter TargetName="Bd" Property="TextBlock.Foreground"
                                        Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="EmptyTabStyle" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0E0E12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== tab strip ===== -->
        <Border Grid.Column="0" Background="#121218"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="8,12">

                <!--
                  Update sits at the bottom of the strip, under the tabs: it is an action
                  on the app itself rather than a category of settings, so it does not
                  belong inside any one tab.
                -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="Update" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,7" HorizontalAlignment="Stretch"
                            ToolTip="Check GitHub for a newer release"
                            Command="{Binding CheckForUpdatesCommand}"/>
                    <TextBlock Text="{Binding UpdateStatus}" FontSize="10.5" Margin="2,6,2,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"
                               Visibility="{Binding HasUpdateStatus,
                                                    Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <StackPanel>
                <RadioButton Style="{StaticResource SettingsTabStyle}" Content="General"
                             IsChecked="{Binding IsGeneral, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="0"/>
                <RadioButton Style="{StaticResource SettingsTabStyle}" Content="Taskbar"
                             IsChecked="{Binding IsTaskbar, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="1"/>
                <RadioButton Style="{StaticResource SettingsTabStyle}" Content="Icons"
                             IsChecked="{Binding IsIcons, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="2"/>
                <RadioButton Style="{StaticResource SettingsTabStyle}" Content="Other"
                             IsChecked="{Binding IsOther, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="3"/>
                <RadioButton Style="{StaticResource SettingsTabStyle}" Content="Advanced"
                             IsChecked="{Binding IsAdvanced, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <Grid>
                <!-- ===== general ===== -->
                <StackPanel Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Wallpaper" Style="{StaticResource SectionHeadingStyle}"/>

                    <!--
                      Wallpaper is per desktop, so this names the one being changed.
                      Switching desktops and reopening Settings changes the target.
                    -->
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{StaticResource MutedTextBrush}">
                        <Run Text="Applies to:"/>
                        <Run Text="{Binding WallpaperScope, Mode=OneWay}"
                             Foreground="{StaticResource AccentBrush}"/>
                        <LineBreak/>
                        <Run Text="Each desktop keeps its own, so the unified desktop and each device can look different."/>
                    </TextBlock>

                    <Border Background="{StaticResource SurfaceHighBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <TextBlock Text="{Binding WallpaperPath}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Choose image..." Style="{StaticResource PrimaryButtonStyle}"
                                Padding="14,7" Margin="0,0,8,0"
                                Command="{Binding ChooseWallpaperCommand}"/>
                        <Button Content="Remove" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="14,7"
                                IsEnabled="{Binding HasWallpaper}"
                                Command="{Binding ClearWallpaperCommand}"/>
                    </StackPanel>

                    <TextBlock Text="Fit" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox Width="180" HorizontalAlignment="Left"
                              ItemsSource="{Binding FitModes}"
                              SelectedItem="{Binding WallpaperFit, Mode=TwoWay}"/>

                    <!--
                      Copies the wallpaper and fit onto every other desktop. Icons are
                      untouched: only the two wallpaper fields are written.
                    -->
                    <Button Content="Apply to all desktops"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,7" HorizontalAlignment="Left" Margin="0,16,0,0"
                            Command="{Binding ApplyWallpaperToAllCommand}"/>

                    <TextBlock Text="{Binding AppliedMessage}" FontSize="11.5" Margin="0,8,0,0"
                               Foreground="{StaticResource OnlineBrush}"
                               Visibility="{Binding HasAppliedMessage,
                                                    Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- ===== taskbar ===== -->
                <StackPanel Visibility="{Binding IsTaskbar, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Show" Style="{StaticResource SectionHeadingStyle}"/>

                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,10"
                              Content="Android control buttons"
                              IsChecked="{Binding Taskbar.ShowNavButtons, Mode=TwoWay}"/>
                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,10"
                              Content="Tabs for open windows"
                              IsChecked="{Binding Taskbar.ShowWindowTabs, Mode=TwoWay}"/>
                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,10"
                              Content="Notifications"
                              IsChecked="{Binding Taskbar.ShowNotifications, Mode=TwoWay}"/>
                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="25,0,0,4"
                              Content="Notification pings"
                              IsEnabled="{Binding Taskbar.ShowNotifications}"
                              IsChecked="{Binding Taskbar.NotificationPings, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="48,0,0,10"
                               Text="Pops up beside the bell when a notification arrives, showing what it was, and fades after a few seconds. Click it to open that phone's shade. Without this the bell still counts them, but only if you look."/>

                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,10"
                              Content="Battery"
                              IsChecked="{Binding Taskbar.ShowBattery, Mode=TwoWay}"/>
                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,10"
                              Content="Clock"
                              IsChecked="{Binding Taskbar.ShowClock, Mode=TwoWay}"/>

                    <TextBlock Text="Layout" Style="{StaticResource SectionHeadingStyle}" Margin="0,18,0,10"/>

                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,4"
                              Content="Reversed control button order"
                              ToolTip="Recents, home, back instead of back, home, recents"
                              IsChecked="{Binding Taskbar.ReverseNavButtons, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="25,0,0,12"
                               Text="Recents, home, back."/>

                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,4"
                              Content="Search as an icon only"
                              IsChecked="{Binding Taskbar.SearchIconOnly, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="25,0,0,12"
                               Text="Collapses the search bar to a single button."/>

                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,4"
                              Content="Disable multiple desktops"
                              IsChecked="{Binding Taskbar.DisableMultiDesktop, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="25,0,0,12"
                               Text="Stays on the unified desktop and hides the U tab and the numbered device boxes. The per-device desktops are kept, just not reachable."/>

                    <TextBlock Text="Clock format" Style="{StaticResource SectionHeadingStyle}"
                               Margin="0,18,0,10"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="0,0,0,10"
                               Text="Standard .NET format strings, rendered in your locale. Pick one or type your own."/>

                    <TextBlock Text="Time" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox Width="200" HorizontalAlignment="Left" IsEditable="True"
                              Margin="0,0,0,10"
                              ItemsSource="{Binding TimeFormats}"
                              Text="{Binding Taskbar.TimeFormat, Mode=TwoWay,
                                             UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Text="Date" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox Width="200" HorizontalAlignment="Left" IsEditable="True"
                              Margin="0,0,0,10"
                              ItemsSource="{Binding DateFormats}"
                              Text="{Binding Taskbar.DateFormat, Mode=TwoWay,
                                             UpdateSourceTrigger=LostFocus}"/>

                    <Border Background="{StaticResource SurfaceHighBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="{Binding Taskbar.Time}" FontSize="12.5"/>
                            <TextBlock Text="{Binding Taskbar.Date}" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== icons ===== -->
                <StackPanel Visibility="{Binding IsIcons, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Appearance" Style="{StaticResource SectionHeadingStyle}"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="0,0,0,12"
                               Text="Applies to every desktop. Individual icons can still be renamed and re-iconned from their right-click menu."/>

                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,4"
                              Content="Background behind icons"
                              IsChecked="{Binding IconBackground, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="25,0,0,12"
                               Text="Off leaves the artwork sitting straight on the wallpaper."/>

                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,4"
                              Content="Scale icons up to fill the box"
                              IsChecked="{Binding ScaleIconsToFit, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="25,0,0,12"
                               Text="Trims the transparent margin off the artwork so icons drawn small inside a large canvas stop looking undersized next to the rest."/>

                    <TextBlock Text="Shape" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox Width="180" HorizontalAlignment="Left"
                              ItemsSource="{Binding IconShapeNames}"
                              SelectedItem="{Binding IconShape, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="0,6,0,0"
                               Text="Shapes the background and clips the artwork to match."/>

                    <TextBlock Text="Which device an app runs on"
                               Style="{StaticResource SectionHeadingStyle}" Margin="0,22,0,10"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="0,0,0,10"
                               Text="Unified desktop only. On a device's own desktop every icon belongs to that device, so there is nothing to tell apart."/>

                    <TextBlock Text="Marker" Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox Width="180" HorizontalAlignment="Left"
                              ItemsSource="{Binding DeviceMarkerNames}"
                              SelectedItem="{Binding DeviceMarker, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="0,6,0,0"
                               Text="Colour puts a bar under the icon in the device's own colour. Badge puts the device's number on it, the same number the taskbar uses."/>

                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="0,8,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               Text="Each device is underlined in its own colour in the connection panel, so you can see which colour is which."
                               Visibility="{Binding IsColourMarker, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- ===== other ===== -->
                <StackPanel Visibility="{Binding IsOther, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Getting started" Style="{StaticResource SectionHeadingStyle}"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="0,0,0,12"
                               Text="The guide that opens the first time adbDesktop runs: connecting a phone over USB or wireless debugging, adding it to the desktop, and what putting an app on the desktop actually does."/>
                    <Button Content="Show the welcome guide"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,7" HorizontalAlignment="Left"
                            Command="{Binding ShowWelcomeCommand}"/>

                    <TextBlock Text="When adbDesktop reopens"
                               Style="{StaticResource SectionHeadingStyle}" Margin="0,22,0,10"/>

                    <ComboBox Width="240" HorizontalAlignment="Left"
                              ItemsSource="{Binding SessionRestoreNames}"
                              SelectedItem="{Binding SessionRestoreMode, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="0,8,0,0"
                               Text="Off forgets everything: every window opens in the middle of the desktop as if it were new. Window position remembers where each app's window was and how big it was, including whether it was snapped, and puts it back there the next time you open that app. Window position and apps also reopens whatever was open when you last closed adbDesktop."/>

                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="0,8,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               Text="Apps come back per device, as each phone connects, so one that is plugged in later still gets its windows. Each device is restored once per run -- reconnecting a phone will not reopen things you have closed since. Anything removed from the desktop in the meantime is skipped."
                               Visibility="{Binding IsSessionRestoreApps, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- ===== advanced ===== -->
                <StackPanel Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Advanced" Style="{StaticResource SectionHeadingStyle}"/>

                    <TextBlock Text="Data folder" Style="{StaticResource LabelTextStyle}"/>
                    <Border Background="{StaticResource SurfaceHighBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <TextBlock Text="{Binding DataFolder}" FontSize="11.5"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Holds adbdesktop.json, the per-desktop layout files and the icon cache."/>
                    <Button Content="Open data folder" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,7" HorizontalAlignment="Left"
                            Command="{Binding OpenDataFolderCommand}"/>

                    <TextBlock Text="Window resizing" Style="{StaticResource SectionHeadingStyle}"
                               Margin="0,22,0,10"/>

                    <TextBlock Text="Resize delay (ms)" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Width="180" HorizontalAlignment="Left"
                             Text="{Binding ResizeDelayMs, Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="0,6,0,0"
                               Text="How long a window must stop changing size before the new size is sent to the phone. Default 220. The window is not blank while it waits -- the last frame is stretched to fit -- which is why the delay is hard to notice. Applies to the next resize; nothing needs restarting."/>

                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="0,8,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               Text="Each size that goes out makes the phone rebuild the virtual display and restart its encoder, so a low value asks for a lot more of those. How low you can usefully go depends on the phone, and going below what it can keep up with does not break anything: the extra requests are dropped rather than queued. If resizing starts to stutter or feel unreliable, raise it again."
                               Visibility="{Binding IsResizeDelayLow, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="0,8,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               Text="Very low values mostly stop making a difference: resizes are already limited by how fast the window itself changes size and by how quickly the phone answers, so past a point the delay is no longer what is holding things up. Harmless to try -- if anything misbehaves, put it back to 220."
                               Visibility="{Binding IsResizeDelayRisky, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeadingStyle}"
                               Margin="0,22,0,10"/>

                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,4"
                              Content="Full diagnostic logging"
                              IsChecked="{Binding DebugLogging, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="25,0,0,6"
                               Text="Writes every adb command and its output, plus scrcpy's own debug messages, to advanced_debug.log in the data folder instead of the normal log. Verbose, and started fresh each time it is switched on. Turn this on before reproducing a problem: when a window fails to connect, the reason the device gave is a debug-level message and is otherwise thrown away."/>
                    <TextBlock Style="{StaticResource EmptyTabStyle}" Margin="25,0,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               Text="Applies to adb straight away; windows already open keep the level they started with, so open the app you want to capture after switching this on."
                               Visibility="{Binding DebugLogging, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="Version" Style="{StaticResource LabelTextStyle}" Margin="0,18,0,5"/>
                    <TextBlock Text="{Binding Version}" FontSize="11.5"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
