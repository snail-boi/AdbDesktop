<UserControl x:Class="AdbDesktop.ConnectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdbDesktop">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:EmptyStringToVisibilityConverter x:Key="EmptyToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock FontSize="15">
                    <TextBlock.Style>
                        <!--
                          BasedOn matters: an inline Style with no BasedOn replaces the
                          implicit TextBlock style outright, taking the near-white
                          Foreground with it and leaving black text on a dark panel.
                        -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Text" Value="Device connection"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPairing}" Value="True">
                                    <Setter Property="Text" Value="Pair over Wi-Fi"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Add a device to give it a desktop of its own. USB always takes priority over wireless when numbering them."
                           Visibility="{Binding IsDeviceListVisible, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource NavButtonStyle}"
                    Width="30" Height="26"
                    FontFamily="Segoe MDL2 Assets" FontSize="10" Content="&#xE8BB;"
                    Foreground="{StaticResource MutedTextBrush}"
                    ToolTip="Close"
                    Command="{Binding DataContext.CloseConnectionCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>

        <!-- ===== device list view ===== -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsDeviceListVisible, Converter={StaticResource BoolToVis}}">

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">

                <TextBlock Text="Wireless mode" Style="{StaticResource LabelTextStyle}"/>
                <ComboBox SelectedIndex="{Binding ModeIndex}" Margin="0,0,0,8">
                    <ComboBoxItem Content="Wireless debugging (Android 11+)"/>
                    <ComboBoxItem Content="TCP/IP (legacy adb tcpip)"/>
                    <ComboBoxItem Content="USB only"/>
                </ComboBox>

                <TextBlock Text="{Binding ModeDetail}" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Pair over Wi-Fi" Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0" Padding="14,7"
                            Command="{Binding StartPairCommand}"/>
                    <Button Content="Enable TCP/IP from USB" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,7"
                            Command="{Binding TcpIpCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5"
                           Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToVis},
                                                ConverterParameter=invert}"/>
            </StackPanel>

            <Grid>
                <ListBox Style="{StaticResource DarkListBoxStyle}"
                         ItemContainerStyle="{StaticResource DarkListItemStyle}"
                         ItemsSource="{Binding Devices}"
                         MaxHeight="210">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,10,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <!--
                                          Red is not reachable; otherwise the colour is the
                                          transport, matching the taskbar: green USB, blue
                                          wireless.
                                        -->
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource WirelessBrush}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsOnline}" Value="True"/>
                                                        <Condition Binding="{Binding IsUsb}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Fill" Value="{StaticResource OnlineBrush}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!--
                                  Connected is not the same as added: adb seeing a device
                                  does not give it a desktop. This is where that happens.
                                -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                            Margin="8,0,0,0">

                                    <!-- add / remove, whichever applies -->
                                    <Button Content="Add to desktop"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="12,5" FontSize="11"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.AddDeviceCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>

                                    <Button Content="Remove"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,5" FontSize="11"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RemoveDeviceCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>

                                    <!--
                                      Per device, not global: marking one phone a fixture
                                      says nothing about the next one plugged into this PC.
                                      Only offered for a device that is actually here.
                                    -->
                                    <CheckBox Style="{StaticResource DarkCheckBoxStyle}"
                                              Content="Auto-add" FontSize="10.5"
                                              Margin="0,6,0,0" HorizontalAlignment="Right"
                                              ToolTip="Put this device back on the desktop by itself whenever it comes online"
                                              Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"
                                              IsChecked="{Binding AutoAdd, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="No devices found. Plug in over USB with USB debugging enabled, or pair over Wi-Fi."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"
                           TextWrapping="Wrap" Margin="10,8" VerticalAlignment="Top"
                           Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DockPanel>

        <!-- ===== pairing view (inline, not a dialog) ===== -->
        <DockPanel Grid.Row="1" DataContext="{Binding Pair}"
                   Visibility="{Binding DataContext.IsPairing,
                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                        Converter={StaticResource BoolToVis}}">

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Back" Style="{StaticResource SecondaryButtonStyle}" Padding="14,7"
                        Margin="0,0,8,0"
                        Command="{Binding DataContext.Connection.CancelPairCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Content="{Binding ModeToggleText}" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,7" Command="{Binding ToggleModeCommand}"/>
            </StackPanel>

            <Grid>
                <!-- QR -->
                <StackPanel Visibility="{Binding IsQrMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Developer options &#x2192; Wireless debugging &#x2192; Pair device with QR code."
                               FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Border Background="White" CornerRadius="6" Padding="8" HorizontalAlignment="Center">
                        <Image Source="{Binding QrImage}" Width="168" Height="168"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <TextBlock Text="{Binding QrStatus}" Foreground="{Binding QrStatusBrush}"
                               FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <!-- manual -->
                <StackPanel Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Pick &quot;Pair device with pairing code&quot; on the phone. Note the pairing port differs from the connection port."
                               FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="IP address and pairing port" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Style="{StaticResource DialogTextBoxStyle}" Margin="0,0,0,10"
                             Text="{Binding PairAddressInput, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Pairing code" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Style="{StaticResource DialogTextBoxStyle}" MaxLength="10" Margin="0,0,0,12"
                             Text="{Binding PairCodeInput, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Content="Pair" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Padding="16,7"
                            IsEnabled="{Binding CanPair}" Command="{Binding PairCommand}"/>

                    <TextBlock Text="{Binding ManualStatus}" Foreground="{Binding ManualStatusBrush}"
                               FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
