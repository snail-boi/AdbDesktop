<UserControl x:Class="AdbDesktop.WindowLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdbDesktop"
             Background="{x:Null}"
             ClipToBounds="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Window caption buttons: smaller and flatter than the shell's. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A candidate window in the snap-assist picker. -->
        <Style x:Key="SnapAssistTileStyle" TargetType="Button">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Padding="8"
                                CornerRadius="8"
                                Background="{StaticResource SurfaceBrush}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource LineBrush}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource SurfaceHighBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible drag handles for the 8 resize directions. -->
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
    <ItemsControl x:Name="Host" ItemsSource="{Binding Windows}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas Background="{x:Null}"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                <Setter Property="Width" Value="{Binding Width}"/>
                <Setter Property="Height" Value="{Binding Height}"/>
                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                <Setter Property="Visibility"
                        Value="{Binding IsVisibleOnDesktop, Converter={StaticResource BoolToVis}}"/>
            </Style>
        </ItemsControl.ItemContainerStyle>

        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <!--
                  UseLayoutRounding so the content area starts and ends on whole device
                  pixels. Positions and sizes come from drag operations in WPF units, and
                  at anything other than 100% display scaling one of those is not a whole
                  device pixel. Left fractional, the video area is a fractional number of
                  real pixels and Stretch=Fill resamples the frame to reach it, which is
                  the same softness the border inset used to cause.

                  BorderThickness comes from AppWindowViewModel.FrameBorderThickness,
                  which is also what gets subtracted to size the virtual display. Bound
                  rather than set here so the two cannot disagree; hard-coding a thickness
                  brings the blur straight back.
                -->
                <Border x:Name="Frame"
                        Background="{StaticResource SurfaceBrush}"
                        BorderThickness="{Binding FrameBorderThickness}"
                        CornerRadius="8"
                        UseLayoutRounding="True"
                        PreviewMouseDown="Window_PreviewMouseDown">

                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 0 while maximised: the bar then floats over the content -->
                            <RowDefinition Height="{Binding TitleBarRow}"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!--
                          A maximised window reveals its title bar by pointer position
                          (UpdateChromeReveal), not by a hit-testable strip: the strip
                          has to be thin to stay out of the app's way, and anything thin
                          enough is also easy to miss and easy for another overlay to
                          cover.
                        -->

                        <!-- ===== title bar ===== -->
                        <Border x:Name="TitleBar"
                                Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="10"
                                VerticalAlignment="Top" Height="32"
                                CornerRadius="7,7,0,0"
                                Background="{StaticResource SurfaceHighBrush}"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                                MouseMove="TitleBar_MouseMove"
                                MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                                LostMouseCapture="TitleBar_LostMouseCapture">
                            <!--
                              Declared here and not in a Setter: a transform in a Setter
                              is one object shared by every window, so they would all
                              slide together.
                            -->
                            <Border.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <!--
                                          Maximised and not being approached: the bar
                                          slides up out of the window instead of being
                                          collapsed, so it retracts as visibly as it
                                          arrives. It stays in the tree at zero opacity,
                                          which is why hit testing is turned off
                                          explicitly: an invisible bar must not swallow
                                          taps meant for the app underneath.

                                          Opacity and the offset are only ever set by
                                          these storyboards. A Setter for either would be
                                          overridden by the animation and never take
                                          effect again, which is also why the maximised
                                          bar's old Opacity="0.96" is gone.
                                        -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMaximized}" Value="True"/>
                                                <Condition Binding="{Binding IsChromeRevealed}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="0" Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                            To="-34" Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="1" Duration="0:0:0.14">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                            To="0" Duration="0:0:0.14">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                        <!-- floating over content: square off the corners -->
                                        <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                            <Setter Property="CornerRadius" Value="0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Margin="8,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0"
                                       Source="{Binding Icon}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"/>

                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           VerticalAlignment="Center" FontSize="12"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <!-- unfocused windows read as dimmed -->
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource MutedTextBrush}"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                                            ToolTip="Minimise"
                                            Command="{Binding DataContext.MinimiseCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <!-- Style set via the element below, so the glyph can
                                         flip between maximise and restore. -->
                                    <Button ToolTip="Maximise / restore"
                                            Command="{Binding DataContext.MaximiseCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                                                <Setter Property="Content" Value="&#xE922;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                                        <Setter Property="Content" Value="&#xE923;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource CaptionCloseStyle}" Content="&#xE8BB;"
                                            ToolTip="Close"
                                            Command="{Binding DataContext.CloseCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ===== content area ===== -->
                        <Border Grid.Row="1" Background="#0E0E12" CornerRadius="0,0,7,7"
                                ClipToBounds="True">
                            <Grid>
                                <!--
                                  The mirrored display. Ordinary WPF content, so the
                                  shell's overlays still compose above it, which is the
                                  whole reason for the frames-over-P/Invoke design
                                  rather than embedding scrcpy's own window.

                                  The virtual display is created at the window's content
                                  size and flexed on resize, so Stretch=Fill matches
                                  1:1 without letterboxing.
                                -->
                                <!--
                                  Background is set so the whole area is hit-testable,
                                  not just where the image has opaque pixels.
                                -->
                                <Grid Background="#0E0E12"
                                      Focusable="True"
                                      Cursor="Arrow"
                                      MouseLeftButtonDown="Video_MouseDown"
                                      MouseLeftButtonUp="Video_MouseUp"
                                      MouseRightButtonDown="Video_RightDown"
                                      MouseRightButtonUp="Video_RightUp"
                                      MouseMove="Video_MouseMove"
                                      MouseWheel="Video_MouseWheel"
                                      Visibility="{Binding HasFrame,
                                                           Converter={StaticResource BoolToVis}}">
                                    <Image Source="{Binding Frame}"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="LowQuality"/>
                                </Grid>

                                <!--
                                  The built-in Settings app: WPF content in place of a
                                  mirrored display. It has no device behind it, so there
                                  is never a frame to wait for.
                                -->
                                <ContentControl Content="{Binding Settings}"
                                                Visibility="{Binding IsSettings,
                                                                     Converter={StaticResource BoolToVis}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <local:SettingsView/>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFrame}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSettings}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Title}" FontSize="14"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="11" Margin="0,6,0,0" Opacity="0.65"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               Text="{Binding Status, Mode=OneWay}"/>
                                    <TextBlock FontSize="10.5" Margin="0,4,0,0" Opacity="0.45"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               Text="{Binding ContentSizeText, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ===== resize grips ===== -->
                        <Grid Grid.Row="0" Grid.RowSpan="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <!-- a maximised window is not resizable -->
                                        <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!--
                              Grab areas are deliberately larger than the visible border
                              and extend a few px outside it (negative margins), because
                              a hit area that stops exactly at the border feels inset and
                              is fiddly to hit. Corners are 20x20 and are declared after
                              the edges so they win the overlap.
                            -->
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="N"
                                   Height="8" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                   Margin="18,-4,18,0" Cursor="SizeNS" DragDelta="Resize_DragDelta"/>
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="S"
                                   Height="8" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                   Margin="18,0,18,-4" Cursor="SizeNS" DragDelta="Resize_DragDelta"/>
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="W"
                                   Width="8" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                   Margin="-4,18,0,18" Cursor="SizeWE" DragDelta="Resize_DragDelta"/>
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="E"
                                   Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                   Margin="0,18,-4,18" Cursor="SizeWE" DragDelta="Resize_DragDelta"/>

                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="NW"
                                   Width="20" Height="20" Margin="-5,-5,0,0"
                                   VerticalAlignment="Top" HorizontalAlignment="Left"
                                   Cursor="SizeNWSE" DragDelta="Resize_DragDelta"/>
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="NE"
                                   Width="20" Height="20" Margin="0,-5,-5,0"
                                   VerticalAlignment="Top" HorizontalAlignment="Right"
                                   Cursor="SizeNESW" DragDelta="Resize_DragDelta"/>
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="SW"
                                   Width="20" Height="20" Margin="-5,0,0,-5"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                   Cursor="SizeNESW" DragDelta="Resize_DragDelta"/>
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="SE"
                                   Width="20" Height="20" Margin="0,0,-5,-5"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                   Cursor="SizeNWSE" DragDelta="Resize_DragDelta"/>
                        </Grid>
                    </Grid>

                    <Border.Style>
                        <Style TargetType="Border">
                            <!--
                              Focus is signalled three ways at once, because a 1px border
                              alone was too easy to miss: a coloured border, a heavier
                              drop shadow, and (in the title bar above) a brighter
                              background with bolder text.

                              The colour is a DynamicResource because Settings can change
                              it; a static one would only reach windows opened afterwards.
                              Nothing is needed here for a maximised window: it is drawn
                              with no border at all (FrameBorderThickness), so whatever
                              this brush is has nothing to paint.
                            -->
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                                      Opacity="0.35" Color="Black"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="28" ShadowDepth="6"
                                                              Opacity="0.6" Color="Black"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!--
      ===== snap preview =====

      The ghost of where a dragged window would land. It sits above the windows rather
      than below them: the window being dragged is under the pointer and would hide
      most of it otherwise, which is the one moment the preview has to be readable.
    -->
    <Canvas IsHitTestVisible="False">
        <Border Canvas.Left="{Binding PreviewX}"
                Canvas.Top="{Binding PreviewY}"
                Width="{Binding PreviewWidth}"
                Height="{Binding PreviewHeight}"
                CornerRadius="8"
                BorderThickness="2"
                BorderBrush="{StaticResource AccentBrush}"
                Visibility="{Binding IsSnapPreviewVisible, Converter={StaticResource BoolToVis}}">
            <Border.Background>
                <SolidColorBrush Color="#4C8DFF" Opacity="0.18"/>
            </Border.Background>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSnapPreviewVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Canvas>

    <!--
      ===== snap assist =====

      Filling one half leaves the other empty, and what belongs there is nearly always
      a window that is already open. The gap is offered as a picker over the empty
      region; clicking the backdrop declines it.
    -->
    <Canvas Visibility="{Binding IsSnapAssistOpen, Converter={StaticResource BoolToVis}}">
        <Border Canvas.Left="{Binding AssistX}"
                Canvas.Top="{Binding AssistY}"
                Width="{Binding AssistWidth}"
                Height="{Binding AssistHeight}"
                Background="#D6101014"
                MouseLeftButtonDown="SnapAssistBackdrop_MouseDown">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="Snap another window here"
                               FontSize="13.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Or click anywhere to leave the space empty"
                               FontSize="11" Opacity="0.7" Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SnapAssistCandidates}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SnapAssistTileStyle}"
                                        Command="{Binding DataContext.SnapAssistPickCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Width="176">
                                        <!--
                                          The live frame doubles as the thumbnail, so the
                                          preview is of the app as it actually looks right
                                          now. Windows with no frame yet (Settings, or one
                                          still connecting) fall back to their icon.
                                        -->
                                        <Border Height="104" CornerRadius="5" ClipToBounds="True"
                                                Background="#0E0E12">
                                            <Grid>
                                                <Image Source="{Binding Frame}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="LowQuality"
                                                       Visibility="{Binding HasFrame,
                                                                            Converter={StaticResource BoolToVis}}"/>
                                                <Image Source="{Binding Icon}" Width="40" Height="40"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFrame}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                   Margin="2,8,2,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Canvas>
    </Grid>
</UserControl>
