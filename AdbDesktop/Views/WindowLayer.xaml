<UserControl x:Class="AdbDesktop.WindowLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdbDesktop"
             Background="{x:Null}"
             ClipToBounds="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Window caption buttons: smaller and flatter than the shell's. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Invisible drag handles for the 8 resize directions. -->
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ItemsControl x:Name="Host" ItemsSource="{Binding Windows}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas Background="{x:Null}"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                <Setter Property="Width" Value="{Binding Width}"/>
                <Setter Property="Height" Value="{Binding Height}"/>
                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                <Setter Property="Visibility"
                        Value="{Binding IsVisibleOnDesktop, Converter={StaticResource BoolToVis}}"/>
            </Style>
        </ItemsControl.ItemContainerStyle>

        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="Frame"
                        Background="{StaticResource SurfaceBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        PreviewMouseDown="Window_PreviewMouseDown">

                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 0 while maximised: the bar then floats over the content -->
                            <RowDefinition Height="{Binding TitleBarRow}"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!--
                          Reveal strip for a maximised window: approaching the top edge
                          slides the title bar back in.
                        -->
                        <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="9"
                                VerticalAlignment="Top" Height="6"
                                Background="Transparent"
                                MouseEnter="WindowChrome_MouseEnter">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- ===== title bar ===== -->
                        <Border x:Name="TitleBar"
                                Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="10"
                                VerticalAlignment="Top" Height="32"
                                CornerRadius="7,7,0,0"
                                Background="{StaticResource SurfaceHighBrush}"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                                MouseMove="TitleBar_MouseMove"
                                MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                                MouseLeave="TitleBar_MouseLeave">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <!-- maximised and not being approached: hidden -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMaximized}" Value="True"/>
                                                <Condition Binding="{Binding IsChromeRevealed}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                        <!-- floating over content: square off the corners -->
                                        <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                            <Setter Property="CornerRadius" Value="0"/>
                                            <Setter Property="Opacity" Value="0.96"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Margin="8,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0"
                                       Source="{Binding Icon}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"/>

                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           VerticalAlignment="Center" FontSize="12"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <!-- unfocused windows read as dimmed -->
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource MutedTextBrush}"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                                            ToolTip="Minimise"
                                            Command="{Binding DataContext.MinimiseCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <!-- Style set via the element below, so the glyph can
                                         flip between maximise and restore. -->
                                    <Button ToolTip="Maximise / restore"
                                            Command="{Binding DataContext.MaximiseCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                                                <Setter Property="Content" Value="&#xE922;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                                        <Setter Property="Content" Value="&#xE923;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource CaptionCloseStyle}" Content="&#xE8BB;"
                                            ToolTip="Close"
                                            Command="{Binding DataContext.CloseCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ===== content area ===== -->
                        <Border Grid.Row="1" Background="#0E0E12" CornerRadius="0,0,7,7"
                                ClipToBounds="True">
                            <Grid>
                                <!--
                                  The mirrored display. Ordinary WPF content, so the
                                  shell's overlays still compose above it, which is the
                                  whole reason for the frames-over-P/Invoke design
                                  rather than embedding scrcpy's own window.

                                  The virtual display is created at the window's content
                                  size and flexed on resize, so Stretch=Fill matches
                                  1:1 without letterboxing.
                                -->
                                <!--
                                  Background is set so the whole area is hit-testable,
                                  not just where the image has opaque pixels.
                                -->
                                <Grid Background="#0E0E12"
                                      Focusable="True"
                                      Cursor="Arrow"
                                      MouseLeftButtonDown="Video_MouseDown"
                                      MouseLeftButtonUp="Video_MouseUp"
                                      MouseRightButtonDown="Video_RightDown"
                                      MouseRightButtonUp="Video_RightUp"
                                      MouseMove="Video_MouseMove"
                                      MouseWheel="Video_MouseWheel"
                                      Visibility="{Binding HasFrame,
                                                           Converter={StaticResource BoolToVis}}">
                                    <Image Source="{Binding Frame}"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="LowQuality"/>
                                </Grid>

                                <!--
                                  The built-in Settings app: WPF content in place of a
                                  mirrored display. It has no device behind it, so there
                                  is never a frame to wait for.
                                -->
                                <ContentControl Content="{Binding Settings}"
                                                Visibility="{Binding IsSettings,
                                                                     Converter={StaticResource BoolToVis}}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <local:SettingsView/>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFrame}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSettings}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Title}" FontSize="14"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="11" Margin="0,6,0,0" Opacity="0.65"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               Text="{Binding Status, Mode=OneWay}"/>
                                    <TextBlock FontSize="10.5" Margin="0,4,0,0" Opacity="0.45"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               Text="{Binding ContentSizeText, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ===== resize grips ===== -->
                        <Grid Grid.Row="0" Grid.RowSpan="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <!-- a maximised window is not resizable -->
                                        <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!--
                              Grab areas are deliberately larger than the visible border
                              and extend a few px outside it (negative margins), because
                              a hit area that stops exactly at the border feels inset and
                              is fiddly to hit. Corners are 20x20 and are declared after
                              the edges so they win the overlap.
                            -->
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="N"
                                   Height="8" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                   Margin="18,-4,18,0" Cursor="SizeNS" DragDelta="Resize_DragDelta"/>
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="S"
                                   Height="8" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                   Margin="18,0,18,-4" Cursor="SizeNS" DragDelta="Resize_DragDelta"/>
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="W"
                                   Width="8" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                   Margin="-4,18,0,18" Cursor="SizeWE" DragDelta="Resize_DragDelta"/>
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="E"
                                   Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                   Margin="0,18,-4,18" Cursor="SizeWE" DragDelta="Resize_DragDelta"/>

                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="NW"
                                   Width="20" Height="20" Margin="-5,-5,0,0"
                                   VerticalAlignment="Top" HorizontalAlignment="Left"
                                   Cursor="SizeNWSE" DragDelta="Resize_DragDelta"/>
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="NE"
                                   Width="20" Height="20" Margin="0,-5,-5,0"
                                   VerticalAlignment="Top" HorizontalAlignment="Right"
                                   Cursor="SizeNESW" DragDelta="Resize_DragDelta"/>
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="SW"
                                   Width="20" Height="20" Margin="-5,0,0,-5"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                   Cursor="SizeNESW" DragDelta="Resize_DragDelta"/>
                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="SE"
                                   Width="20" Height="20" Margin="0,0,-5,-5"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                   Cursor="SizeNWSE" DragDelta="Resize_DragDelta"/>
                        </Grid>
                    </Grid>

                    <Border.Style>
                        <Style TargetType="Border">
                            <!--
                              Focus is signalled three ways at once, because a 1px border
                              alone was too easy to miss: an accent border, a heavier
                              drop shadow, and (in the title bar above) a brighter
                              background with bolder text.
                            -->
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                                      Opacity="0.35" Color="Black"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="28" ShadowDepth="6"
                                                              Opacity="0.6" Color="Black"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
