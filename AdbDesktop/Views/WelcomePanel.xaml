<UserControl x:Class="AdbDesktop.WelcomePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdbDesktop">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <DockPanel Margin="24">

        <!-- ===== header: title, then the page dots ===== -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="{Binding Current.Title}" FontSize="20"/>
                <TextBlock Text="{Binding Current.Lead}" FontSize="12.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>

            <!--
              One dot per page, bound to the pages themselves: each knows whether it is
              the one on screen, so nothing here has to compare indices.
            -->
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Steps}"
                          VerticalAlignment="Top" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="7" Height="7" CornerRadius="3.5" Margin="3,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource LineBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- ===== footer ===== -->
        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Skip" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,7" Command="{Binding SkipCommand}"
                        ToolTip="Close the guide. Settings → Other opens it again."/>
                <TextBlock Text="{Binding ProgressText}" FontSize="11.5" Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!--
                  Kept in place rather than hidden on the first page, so the two buttons
                  do not shuffle sideways as the guide is paged through.
                -->
                <Button Content="Back" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,7" Margin="0,0,8,0"
                        Command="{Binding BackCommand}"/>
                <Button Content="{Binding NextText}" Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="110" Command="{Binding NextCommand}"/>
            </StackPanel>
        </Grid>

        <!--
          The body. MinHeight holds the card at roughly the size of its longest page, so
          paging through does not make the whole thing jump about; the ScrollViewer is
          the backstop for a small window or a large system font.
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MinHeight="250" MaxHeight="420">
            <StackPanel Margin="0,0,6,0">
                <ItemsControl ItemsSource="{Binding Current.Points}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceHighBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14,11" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" FontSize="12.5"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Text}" FontSize="11.5"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" Margin="0,5,0,0"
                                               LineHeight="17"
                                               LineStackingStrategy="BlockLineHeight"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Current.Footnote}" FontSize="11.5"
                           Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap" Margin="2,6,0,0"
                           LineHeight="17" LineStackingStrategy="BlockLineHeight"
                           Visibility="{Binding Current.HasFootnote,
                                                Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
